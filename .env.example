# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Paisa Vasool - Dispute Service
VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8002
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=
ALGORITHM=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis & Celery ────────────────────────────────────────────────────────────
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_INVOICE_MODEL=llama-3.1-8b-instant

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_INVOICE_MODEL=gemini-2.0-flash

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=["pdf"]

# ── Attachment Storage (local fallback) ───────────────────────────────────────
ATTACHMENT_STORAGE_DIR=

# ── Google Cloud Storage ──────────────────────────────────────────────────────
GCS_ENABLED=
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_BUCKET_PREFIX=
GCS_TARGET_SERVICE_ACCOUNT=

# ── AI Agent Email (system auto-responder) ────────────────────────────────────
AGENT_EMAIL=
AGENT_EMAIL_PASSWORD=
AGENT_SMTP_HOST=
AGENT_SMTP_PORT=
AGENT_SMTP_USE_TLS=

# ── IMAP Polling ──────────────────────────────────────────────────────────────
EMAIL_POLL_INTERVAL_SECONDS=20

# ── Memory / Summarization ────────────────────────────────────────────────────
EPISODE_SUMMARIZE_THRESHOLD=10

# ── Langfuse Observability ────────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMS=768
EPISODE_SIMILARITY_THRESHOLD=0.75

# ── Fastembed Cache (set by Dockerfile — do not change) ───────────────────────
FASTEMBED_CACHE_PATH=